import java.util.*;

class Strmenu {
    public static void main(String args[]) {
        String s1, s2;
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter two strings:");
        s1 = sc.nextLine();
        s2 = sc.nextLine();

        int len1 = s1.length();
        int len2 = s2.length();
        System.out.println("Length of the first string: " + len1);
        System.out.println("Length of the second string: " + len2);

        String concatenatedString = s1 + s2;
        System.out.println("Concatenated string: " + concatenatedString);

        boolean isEqual = s1.equals(s2);
        System.out.println("Are the strings equal? " + isEqual);

        s1 = s2;
        System.out.println("Copied value of s1: " + s1);
        System.out.println("Value of s2 remains: " + s2);
    }
}






import java.util.Scanner;

public class StringManipulations {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.println("Enter the first string:");
        String str1 = scanner.nextLine();

        System.out.println("Enter the second string:");
        String str2 = scanner.nextLine();

        // Length of both strings
        System.out.println("Length of the first string: " + str1.length());
        System.out.println("Length of the second string: " + str2.length());

        // Concatenate the strings
        String concatenatedString = str1 + str2;
        System.out.println("Concatenated string: " + concatenatedString);

        // Compare the strings
        if (str1.equals(str2)) {
            System.out.println("The strings are equal.");
        } else {
            System.out.println("The strings are not equal.");
        }

        // Copy the second string to the first string
        str1 = str2;
        System.out.println("Copied value of the first string: " + str1);
        System.out.println("Value of the second string remains: " + str2);

        scanner.close();
    }
}


